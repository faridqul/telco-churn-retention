# Scoring output -- regenerated on every run of telco_model.py.
# The trained artifacts (xgboost_churn_pipeline.pkl, model_metadata.json)
# and the sample input (simulated_new_customers.csv) are deliberately
# committed instead, so the API and batch script run straight after a
# clone without re-running the notebook first.
retention_campaign_targets.csv

# Python
__pycache__/
*.pyc
*.egg-info/

# Virtual environments
venv/
.venv/

# Testing
.pytest_cache/

# uv
.uv/

# Jupyter
.ipynb_checkpoints/

# OS/editor clutter
.DS_Store
.vscode/
.idea/

# Local scratch notes (kept on disk, not part of the repo)
docs/AUDIT.md

# Results of runs -- LLM live runs, reports, anything a script writes that
# can be regenerated. The folder itself is kept (.gitkeep) so a path like
# outputs/stage1_v2.json works on a fresh clone.
outputs/*
!outputs/.gitkeep

# The narration cache (narration_cache.py). Disposable by design: it holds
# answers that were already paid for and can be rebuilt from outputs/ with
# `--import-all`. Never committed -- it is a local cost guard, not a
# measurement.
data/

.env
.env.*
